# SketchyBar — floating Gruvbox bar
# Matches the Ghostty / Alacritty background (Gruvbox Dark #282828).
# Docs: https://felixkratz.github.io/SketchyBar/

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Gruvbox palette #####
BG=0xff282828          # bg0  — matches terminal background
BG1=0xff3c3836         # bg1  — item bubbles
BG2=0xff504945         # bg2  — borders
FG=0xffebdbb2          # fg   — text
GRAY=0xff928374

RED=0xfffb4934
GREEN=0xffb8bb26
YELLOW=0xfffabd2f
BLUE=0xff83a598
PURPLE=0xffd3869b
AQUA=0xff8ec07c
ORANGE=0xfffe8019

##### Bar Appearance #####
# A floating bar: pinned to the bottom, lifted up with y_offset, inset from the
# screen edges with margin, and rounded. Border gives it a subtle frame.
sketchybar --bar \
  position=bottom \
  height=32 \
  margin=10 \
  y_offset=4 \
  corner_radius=14 \
  border_width=2 \
  border_color=$BG2 \
  color=$BG \
  padding_left=10 \
  padding_right=10 \
  blur_radius=0 \
  sticky=on \
  topmost=on

##### Changing Defaults #####
default=(
  padding_left=4
  padding_right=4
  icon.font="Hack Nerd Font:Bold:15.0"
  label.font="Hack Nerd Font:Bold:13.0"
  icon.color=$FG
  label.color=$FG
  icon.padding_left=8
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=8
  background.height=24
  background.corner_radius=8
)
sketchybar --default "${default[@]}"

##### Left: Workspaces #####
sketchybar --add event aerospace_workspace_change

for sid in $(aerospace list-workspaces --all); do
    sketchybar --add item space.$sid left \
        --subscribe space.$sid aerospace_workspace_change \
        --set space.$sid \
        background.color=$BG1 \
        background.corner_radius=8 \
        background.height=24 \
        background.drawing=on \
        icon="$sid" \
        icon.font="Hack Nerd Font:Bold:13.0" \
        icon.padding_left=10 \
        icon.padding_right=10 \
        label.drawing=off \
        padding_left=3 \
        padding_right=3 \
        click_script="aerospace workspace $sid" \
        script="$PLUGIN_DIR/aerospace.sh $sid"
done

##### Left: Focused App #####
sketchybar --add item front_app left \
           --set front_app \
             icon.drawing=off \
             label.color=$FG \
             background.drawing=on \
             background.color=$BG1 \
             background.corner_radius=8 \
             background.height=24 \
             padding_left=6 \
             script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

##### Right: Status items #####
# Each item carries its own accent-colored icon; a bracket wraps them all in a
# single rounded bubble for a clean, unified look.

CLOCK_ICON=$(printf '\357\220\272')  # nf-md-calendar_clock  U+F43A

sketchybar --add item clock right \
           --set clock \
             update_freq=10 \
             icon="$CLOCK_ICON" \
             icon.color=$BLUE \
             script="$PLUGIN_DIR/clock.sh" \
           --add item volume right \
           --set volume \
             icon.color=$AQUA \
             script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change \
           --add item battery right \
           --set battery \
             update_freq=120 \
             icon.color=$GREEN \
             script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change

##### Right: System info #####
# Network, Bluetooth, VPN (only shown when connected) and keyboard layout.

sketchybar --add item network right \
           --set network \
             update_freq=15 \
             script="$PLUGIN_DIR/network.sh" \
           --subscribe network wifi_change system_woke \
           --add item bluetooth right \
           --set bluetooth \
             update_freq=30 \
             script="$PLUGIN_DIR/bluetooth.sh" \
           --subscribe bluetooth system_woke \
           --add item vpn right \
           --set vpn \
             update_freq=10 \
             drawing=off \
             script="$PLUGIN_DIR/vpn.sh" \
           --subscribe vpn system_woke \
           --add item keyboard right \
           --set keyboard \
             update_freq=5 \
             script="$PLUGIN_DIR/keyboard.sh"

# Wrap every right-side item in a single rounded bubble.
sketchybar --add bracket status \
             keyboard vpn bluetooth network battery volume clock \
           --set status \
             background.color=$BG1 \
             background.corner_radius=8 \
             background.height=24 \
             background.border_width=1 \
             background.border_color=$BG2

##### Force all scripts to run the first time #####
sketchybar --update
